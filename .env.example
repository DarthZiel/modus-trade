# Local development only; change credentials before deployment.
POSTGRES_USER=modus
POSTGRES_PASSWORD=modus_local
POSTGRES_DB=modus
WEB_PORT=5173
API_PORT=8000
# Optional: required only for the bot profile.
BOT_TOKEN=
BOT_USERNAME=
# Generate independently: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_API_SECRET=
# Public HTTPS origin without trailing slash or /mini path.
MINI_APP_URL=

# Set true when serving the app over HTTPS.
COOKIE_SECURE=false

# AI_PROVIDER: disabled, demo (local templates, no model), openai, openrouter
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=

# Модель — точный ID из OpenRouter; пустая модель эксперимента использует основную.
OPENROUTER_MODEL=
OPENROUTER_EXPERIMENT_MODEL=
OPENROUTER_OUTPUT_MODE=schema
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=2500
