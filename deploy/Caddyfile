{
	email {$ACME_EMAIL}
}

(headers) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

iron-tech.kz {
	import headers
	reverse_proxy landing:80
}

www.iron-tech.kz {
	redir https://iron-tech.kz{uri} permanent
}

feedback.iron-tech.kz {
	import headers
	request_body {
		max_size 54525952
	}
	handle_path /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}
