      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Hero action linking to selected work.",
      "html": "<a class=\"ds-primary\" href=\"#projects\">Смотреть проекты ↘</a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;border:1px solid transparent;border-radius:6px;font:500 14px \"Golos Text Variable\",sans-serif;text-decoration:none;transition:transform 140ms cubic-bezier(.23,1,.32,1),background-color 160ms ease;height:54px;padding:0 25px;background:var(--primary,#2454e8);color:var(--primary-foreground,#fff);gap:28px}.ds-primary:hover{background:color-mix(in oklab,var(--primary,#2454e8) 80%,transparent)}.ds-primary:focus-visible{outline:3px solid var(--ring, #2454e8);outline-offset:5px;}.ds-primary:active{transform:scale(.97)}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active{transform:none}}"
